# ===================================================
# INSTA CRM - Environment Configuration Template
# ===================================================

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
POSTGRES_USER=insta_user
POSTGRES_PASSWORD=insta_password
POSTGRES_DB=insta_crm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://insta_user:insta_password@localhost:5432/insta_crm

# Meta / Instagram Graph API
META_APP_ID=1778820670044125
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=insta_crm_verify_token_dev

# AI Provider (Mistral AI)
MISTRAL_API_KEY=
AI_MODEL=open-mistral-7b

# Initial Admin Credentials (for first-time seeding)
FIRST_ADMIN_EMAIL=admin@instacrm.local
FIRST_ADMIN_PASSWORD=AdminSecurePassword123!
